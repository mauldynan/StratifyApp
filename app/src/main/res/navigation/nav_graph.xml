<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <!-- 🔐 Login Activity -->
    <activity
        android:id="@+id/loginActivity"
        android:name="com.example.stratify.LoginActivity"
        tools:layout="@layout/activity_login" />

    <!-- 🌍 Global Action -->
    <action
        android:id="@+id/action_global_loginActivity"
        app:destination="@id/loginActivity"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!-- 🏠 Home / Dashboard -->
    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.stratify.FragmentDashboard"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_fullAnalysisFragment"
            app:destination="@id/fullAnalysisFragment" />

        <action
            android:id="@+id/action_dashboardFragment_to_profileOptionsFragment"
            app:destination="@id/profileOptionsFragment" />
    </fragment>

    <!-- 👤 Profile Options (Dialog) -->
    <dialog
        android:id="@+id/profileOptionsFragment"
        android:name="com.example.stratify.view.user.ProfileOptionsFragment"
        android:label="Profile Options"
        tools:layout="@layout/fragment_profile_options">

        <!-- ✏️ Navigate to Edit Profile -->
        <action
            android:id="@+id/action_profileOptionsFragment_to_profileEditFragment"
            app:destination="@id/profileEditFragment" />

        <!-- ⚙️ Navigate to Account -->
        <action
            android:id="@+id/action_profileOptionsFragment_to_accountFragment"
            app:destination="@id/accountFragment" />
    </dialog>

    <!-- 📊 Full Analysis -->
    <fragment
        android:id="@+id/fullAnalysisFragment"
        android:name="com.example.stratify.FullAnalysisFragment"
        android:label="Full Analysis"
        tools:layout="@layout/fragment_full_analysis" />

    <!-- 🧩 Workspace -->
    <fragment
        android:id="@+id/navigation_workspace"
        android:name="com.example.stratify.StartFragment"
        android:label="Workspace"
        tools:layout="@layout/fragment_start">

        <action
            android:id="@+id/action_startFragment_to_createWorkspaceFragment"
            app:destination="@id/createWorkspaceFragment" />

        <action
            android:id="@+id/action_startFragment_to_joinWorkspaceFragment"
            app:destination="@id/joinWorkspaceFragment" />

        <argument
            android:name="showBackButton"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>

    <fragment
        android:id="@+id/createWorkspaceFragment"
        android:name="com.example.stratify.CreateWorkspaceFragment"
        android:label="Create Workspace"
        tools:layout="@layout/fragment_create_workspace">

        <action
            android:id="@+id/action_createWorkspaceFragment_to_workspaceListFragment"
            app:destination="@id/workspaceListFragment"
            app:popUpTo="@id/navigation_workspace"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/joinWorkspaceFragment"
        android:name="com.example.stratify.JoinWorkspaceFragment"
        android:label="Join Workspace"
        tools:layout="@layout/fragment_join_workspace">

        <action
            android:id="@+id/action_joinWorkspaceFragment_to_workspaceListFragment"
            app:destination="@id/workspaceListFragment"
            app:popUpTo="@id/navigation_workspace"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/workspaceListFragment"
        android:name="com.example.stratify.WorkspaceListFragment"
        android:label="Workspace List"
        tools:layout="@layout/fragment_workspace_list">

        <action
            android:id="@+id/action_workspaceListFragment_to_startFragment"
            app:destination="@id/navigation_workspace"
            app:popUpTo="@id/navigation_workspace"
            app:popUpToInclusive="true">
            <argument
                android:name="showBackButton"
                android:defaultValue="true" />
        </action>

        <action
            android:id="@+id/action_workspaceListFragment_to_workspaceDetailFragment"
            app:destination="@id/workspaceDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/workspaceDetailFragment"
        android:name="com.example.stratify.WorkspaceDetailFragment"
        android:label="Workspace Detail"
        tools:layout="@layout/fragment_workspace_detail">
        <argument
            android:name="workspace"
            app:argType="com.example.stratify.Workspace" />
    </fragment>

    <!-- ✏️ Profile Edit -->
    <fragment
        android:id="@+id/profileEditFragment"
        android:name="com.example.stratify.ProfileEditFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_profile_edit" />

    <!-- ⚙️ Account -->
    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.stratify.view.profile.AccountFragment"
        android:label="Account"
        tools:layout="@layout/fragment_account" />

    <!-- 🌐 Languages -->
    <fragment
        android:id="@+id/languagesFragment"
        android:name="com.example.stratify.LanguagesFragment"
        android:label="Languages"
        tools:layout="@layout/fragment_languages" />

    <!-- 💬 Scrum -->
    <fragment
        android:id="@+id/navigation_scrum"
        android:name="com.example.scrum_section.ScrumFragment"
        android:label="@string/title_scrum"
        tools:layout="@layout/fragment_scrum" />

</navigation>
