rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember(workspaceData) {
      return request.auth.uid in workspaceData.memberIds;
    }

    function isCreator(workspaceData) {
      return request.auth.uid == workspaceData.creatorId;
    }

    // Workspaces collection (existing rules with safe constraints)
    match /workspaces/{workspaceId} {

      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.memberIds.size() >= 1
        && request.auth.uid in request.resource.data.memberIds;

      allow read: if isAuthenticated();

      allow update: if isAuthenticated()
        && (
          (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'memberIds', 'memberPhotos', 'updatedAt'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.auth.uid in request.resource.data.memberIds
            && !(request.auth.uid in resource.data.memberIds))
          ||
          (isMember(resource.data)
            && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['creatorId', 'password', 'id']))
        );

      allow delete: if isAuthenticated() && isCreator(resource.data);

      match /progress/{progressId} {
        allow read: if isAuthenticated() && isMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data);
        allow create: if isAuthenticated() && isMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data);
        allow update, delete: if isAuthenticated() && isMember(get(/databases/$(database)/documents/workspaces/$(workspaceId)).data);
      }
    }

    // Users collection and subcollections
    match /users/{userId} {
      // Allow read of user doc to authenticated callers (you can tighten if needed)
      allow read: if isAuthenticated();
      // Only the user themself may write their own top-level user doc
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Subcollection: scrum_tasks — each user may read/write only their own tasks
      match /scrum_tasks/{taskId} {
        allow read: if isAuthenticated() && request.auth.uid == userId;
        allow create: if isAuthenticated() && request.auth.uid == userId
          && request.resource.data.keys().hasAll(['name', 'description', 'estimation', 'deadline', 'status'])
          && request.resource.data.name is string
          && request.resource.data.description is string
          && request.resource.data.estimation is string
          && request.resource.data.deadline is string
          && request.resource.data.status is string;
        allow update: if isAuthenticated() && request.auth.uid == userId
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','description','estimation','deadline','status','updatedAt'])
            || request.resource.data.diff(resource.data).affectedKeys().size() == 0);
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Public review collections used by dashboard
    match /shopee/{reviewId} {
      allow read: if true;
    }

    match /tokopedia/{reviewId} {
      allow read: if true;
    }

    match /tiktok/{reviewId} {
      allow read: if true;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
